# Public Supabase project URL (required outside local preview)
SUPABASE_URL=
# Supabase publishable/anon key; never put a service-role key here
SUPABASE_PUBLISHABLE_KEY=
# Optional legacy fallback for older Supabase projects; prefer SUPABASE_PUBLISHABLE_KEY
# SUPABASE_ANON_KEY=
# UUID of the single owner allowed by the server and RLS allowlist
OWNER_USER_ID=
# Same-origin deployment URL, for example https://learn.example.com
APP_ORIGIN=
# Node API port; defaults to 4173
PORT=
# Set to 1 only for loopback development. Keep empty in production.
LOCAL_PREVIEW=
# Optional listen address; production defaults to 0.0.0.0.
HOST=
